JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Existing SQL Server (SQL authentication; Windows trusted auth doesn't work in Linux containers).
# Use host.docker.internal if SQL Server runs on the Docker host.
DATABASE_URL=mssql+pyodbc://USER:PASSWORD@host.docker.internal:1433/Convergence?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
